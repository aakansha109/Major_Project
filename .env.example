# Chronos Memory Environment Configuration

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Neo4j Graph Database
# Use bolt://localhost:7687 for local execution, or bolt://neo4j:7687 inside Docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chronos_memory_2026
NEO4J_DATABASE=neo4j

# LLM Fallback (OpenAI-compatible: OpenAI, Groq, Ollama, OpenRouter, etc.)
# If left empty, Chronos operates in pure deterministic rule-based mode (Zero LLM cost)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ENABLE_LLM_FALLBACK=true
EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# Persistence Directory for Local Vectors & Fallback Storage
LOCAL_DATA_DIR=./data

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000
